# =============================================================================
# Docker build context exclusions
# =============================================================================

# Dependencies (will be installed during build)
node_modules/
.pnp
.pnp.js

# Build output (will be generated during build)
dist/
dist-ssr/
.vite/

# PocketBase local binary & data (downloaded inside container, data is a volume)
pocketbase
pocketbase.exe
pocketbase.zip
pb_data/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Git and GitHub
.git/
.gitignore
.gitmodules
.github/

# Editor & IDE files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Environment files (use docker-compose env_file or pass at runtime)
.env
.env.local
.env.*.local

# TypeScript incremental build info
*.tsbuildinfo

# One-off utility scripts (not needed in image)
convert.cjs
convert_dari_kami.cjs
removeAos.cjs
updateAos.cjs
download_pocketbase.sh
setup-pocketbase.ps1

# Lock files not used (only pnpm-lock.yaml)
package-lock.json
yarn.lock

# Docker config
docker-compose*.yml
Dockerfile

# Figma cache
.figma/

# Markdown docs
*.md
README*
LICENSE*
CHANGELOG*
# Nginx reverse proxy (image terpisah)
nginx/
