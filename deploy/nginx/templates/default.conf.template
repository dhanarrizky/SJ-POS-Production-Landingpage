# nginx milik stack landing: HTTP polos di :8081, hanya terjangkau dari network Docker `pos_network`
# (TLS dan domain ditangani nginx repo INFRA). Diproses envsubst oleh image nginx saat start;
# variabel yang dipakai: MEDIA_UPSTREAM.

resolver 127.0.0.11 valid=10s ipv6=off;

upstream pocketbase {
    server landing:8080;
    keepalive 32;
}

server {
    listen 8081;
    server_name _;
    server_tokens off;

    client_max_body_size 50M;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_proxied any;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json application/javascript
               application/xml application/rss+xml image/svg+xml;

    # IP client asli sudah diset nginx INFRA di header ini; port 8081 tidak dibuka ke host,
    # jadi header hanya bisa datang dari INFRA. Diteruskan apa adanya ke PocketBase.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $http_x_real_ip;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Host $http_x_forwarded_host;

    # Gambar statis dari SeaweedFS (bucket bersama) lewat /media/ (hindari mixed content).
    # Di-resolve saat request (resolver Docker): nginx tetap start walau stack infra/storage belum jalan.
    location ~ ^/media/(?<media_path>.+)$ {
        limit_except GET { deny all; }

        set $media_upstream ${MEDIA_UPSTREAM};
        proxy_pass $media_upstream/$media_path$is_args$args;
        proxy_set_header Host storage:8333;
        proxy_set_header Authorization "";
        proxy_hide_header Set-Cookie;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header Server;

        expires 30d;
    }

    # Realtime (SSE) PocketBase — jangan di-buffer
    location /api/realtime {
        proxy_pass http://pocketbase;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://pocketbase;
        proxy_read_timeout 120s;
    }
}
